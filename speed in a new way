from math import sqrt

class Wave():
    #for speedControlBus
    def __init__(self, V, f, m, Z):
        self.tension=V
        self.frequency=f
        self.mass=m
        self.impedance=Z

    def max_speed(self):
        if(self.tension==0 or self.frequency==0 or self.mass==0 or self.impedance==0):
            pass
        else:
            max_speed=self.tension/sqrt(self.frequency*self.mass*self.impedance)
            return(max_speed)

    def nominal_speed(self):
        if(self.tension==0 or self.frequency==0 or self.mass==0 or self.impedance==0):
            pass
        else:
            nominal_speed=self.tension/sqrt(2*self.frequency*self.mass*self.impedance)
            return(nominal_speed)

class Variation():
    #for presenceControlBus
    def __init__(self, measure_0, measure):
        self.measure_0=measure_0
        self.measure=measure

    def solve(self):
        if(self.measure_0!=0):
            delta=self.measure-self.measure_0
            return(delta)
        else:
            return None

class Divergence():
    #for nominalControlBus
    def __init__(self, w, V, f, m, Z):
        self.speed=w
        self.tension=V
        self.frequency=f
        self.mass=m
        self.impedance=Z

    def for_speed(self):
        if(self.tension==0 or self.frequency==0 or self.mass==0 or self.impedance==0):
            return None
        else:
            pdV=1/sqrt(self.frequency*self.mass*self.impedance)
            pdf=-self.tension/(2*self.frequency*sqrt(self.frequency*self.mass*self.impedance))
            pdm=-self.tension/(2*self.mass*sqrt(self.frequency*self.mass*self.impedance))
            pdZ=-self.tension/(2*self.impedance*sqrt(self.frequency*self.mass*self.impedance))
            divergencew=pdV+pdf+pdm+pdZ
            return(divergencew)

    def for_tension(self):
        if(self.speed==0 or self.frequency==0 or self.mass==0 or self.impedance==0):
            return None
        else:
            pdw=sqrt(self.frequency*self.mass*self.impedance)
            pdf=(self.speed*sqrt(self.mass*self.impedance))/(2*sqrt(self.frequency))
            pdm=(self.speed*sqrt(self.frequency*self.impedance))/(2*sqrt(self.mass))
            pdZ=(self.speed*sqrt(self.frequency*self.mass))/(2*sqrt(self.impedance))
            divergenceV=pdw+pdf+pdm+pdZ
            return(divergenceV)

    def for_frequency(self):
        if(self.speed==0 or self.tension==0 or self.mass==0 or self.impedance==0):
            return None
        else:
            pdV=(2*self.tension)/(self.mass*self.impedance*self.speed**2)
            pdm=-(self.tension**2)/(self.mass**2*self.impedance*self.speed**2)
            pdZ=-(self.tension**2)/(self.mass*self.impedance**2*self.speed**2)
            pdw=-(2*self.tension**2)/(self.mass*self.impedance*self.speed**3)
            divergencef=pdV+pdm+pdZ+pdw
            return(divergencef)

    def for_mass(self):
        if(self.speed==0 or self.tension==0 or self.frequency==0 or self.impedance==0):
            return None
        else:
            pdV=(2*self.tension)/(self.frequency*self.impedance*self.speed**2)
            pdf=-(self.tension**2)/(self.frequency**2*self.impedance*self.speed**2)
            pdZ=-(self.tension**2)/(self.frequency*self.impedance**2*self.speed**2)
            pdw=-(2*self.tension**2)/(self.frequency*self.impedance*self.speed**3)
            divergencem=pdV+pdf+pdZ+pdw
            return(divergencem)

    def for_impedance(self):
        if(self.speed==0 or self.tension==0 or self.frequency==0 or self.mass==0):
            return None
        else:
            pdV=(2*self.tension)/(self.frequency*self.mass*self.speed**2)
            pdf=-(self.tension**2)/(self.frequency**2*self.mass*self.speed**2)
            pdm=-(self.tension**2)/(self.frequency*self.mass**2*self.speed**2)
            pdw=-(2*self.tension**2)/(self.frequency*self.mass*self.speed**3)
            divergenceZ=pdV+pdm+pdf+pdw
            return(divergenceZ)
